doctype html
html(lang='es')
    head
        title= titulo
        link(href='css/bootstrap.min.css' rel='stylesheet')
        link(href='css/estilos.css' rel='stylesheet')
    body
        header.container
            div.row
                h1.col-sm-12.text-center=titulo 
                nav.col-sm-12.navbar.navbar-expand-lg.bg-body-tertiary
                    div.container-fluid
                        button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Toggle navigation")
                            span.navbar-toggler-icon
                        div.collapse.navbar-collapse#menu
                            ul.navbar-nav
                                li.nav-item
                                    a.nav-link(href='/' class=(activa === 'inicio' ? 'active' : '' )) Inicio 
                                li.nav-item 
                                    a.nav-link(href='/acordeon' class=(activa === 'acordeon' ? 'active': '' )) Accordion
                                li.nav-item
                                    a.nav-link(href='/modal' class=(activa === 'modal' ? 'active': '' )) Ventana Modal
                                li.nav-item 
                                    a.nav-link(href='/tooltips' class=(activa === 'tooltips' ? 'active': '' )) ToolTips
        main#contenidos
            block contenido
        script(src='js/bootstrap.bundle.min.js')
        script(src='js/script.js')